DATABASE_URL="postgres://user:password@host/db?sslmode=require"
GEMINI_API_KEY=""
BLOB_READ_WRITE_TOKEN=""
GEMINI_MODEL="gemini-2.5-flash"

# SMTP for outbound missing-upload emails. When unset, the mailer logs instead of sending.
# Example for Gmail: host smtp.gmail.com, port 587, secure false, user = your address,
# pass = a Google App Password (not your account password).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Twilio for outbound agency SMS / calls (the call_agency / sms_agency worker actions).
# ENV-ONLY — there are NO hardcoded fallbacks in config.js for these. When any of
# ACCOUNT_SID / AUTH_TOKEN / FROM_NUMBER is unset, api/_lib/twilio.js degrades to a
# no-op ({ sent:false, skipped:true, reason:'twilio_not_configured' }) and never throws.
# FROM_NUMBER must be an E.164 Twilio number you own (e.g. +15551234567).
# TWILIO_TO_OVERRIDE (optional): when set, every outbound SMS/call is redirected to this
# one number — use it to demo safely without dialing a real agency.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_TO_OVERRIDE=""
