DATABASE_URL="postgres://user:password@host/db?sslmode=require"
GEMINI_API_KEY=""
BLOB_READ_WRITE_TOKEN=""
GEMINI_MODEL="gemini-2.5-flash"

# SMTP for outbound missing-upload emails. When unset, the mailer logs instead of sending.
# Example for Gmail: host smtp.gmail.com, port 587, secure false, user = your address,
# pass = a Google App Password (not your account password).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
